from datetime import datetime, timedelta, timezone
from airflow import DAG
from airflow.providers.google.cloud.operators.dataproc import DataprocSubmitJobOperator
from airflow.operators.python_operator import PythonOperator
from google.cloud import dataproc_v1
from google.api_core.client_options import ClientOptions

default_args = {
    'owner': '819128668990-compute',
    'start_date': '2025-11-17 08:37:44.694158+08:00',
    'retries': '0',
    'retry_delay': timedelta(minutes=int('5')),
    'email': [],
    'email_on_failure': False,
    'email_on_retry': False,
    'email_on_success': False
}

def write_output_to_file(run_id, notebook_name, **kwargs):
    # This function now takes notebook_name to create unique output paths
    output_file_path = f"gs://us-central1-testcomposer-9d6c1b93-bucket/dataproc-output/7run/output-notebooks/{notebook_name.replace('.ipynb', '')}_{run_id}.ipynb"
    print(output_file_path)
    kwargs['ti'].xcom_push(key=f'output_file_path_{notebook_name.replace(".ipynb", "")}', value=output_file_path)
    return output_file_path

time_zone = 'Asia/Singapore'
stop_cluster_check = 'False' # This value is hardcoded as 'False', so the stop_the_cluster function will never execute.

def get_client_cert():
    # code to load client certificate and private key.
    # IMPORTANT: Ensure this function is correctly implemented to fetch credentials securely.
    # For a typical Cloud Composer setup, service account credentials often handle authentication,
    # so a client certificate might not be strictly necessary unless specific security policies require it.
    return client_cert_bytes, client_private_key_bytes

def get_cluster_state_start_if_not_running():
    # This function attempts to start the cluster if it's not running.
    # Ensure client_cert_source is properly configured if required.
    try:
        options = ClientOptions(api_endpoint="us-central1-dataproc.googleapis.com:443",
        client_cert_source=get_client_cert)
    except NameError:
        # Fallback if get_client_cert is not defined or not needed for the environment
        options = ClientOptions(api_endpoint="us-central1-dataproc.googleapis.com:443")

    client = dataproc_v1.ClusterControllerClient(client_options=options)
    request = dataproc_v1.GetClusterRequest(
        project_id='qwiklabs-gcp-03-6e8213d90fd1',
        region='us-central1',
        cluster_name='my-ac-cluster',
    )
    response = client.get_cluster(request=request)

    print(f"State is {response.status.state}")
    if response.status.state in (6, 7): # STOPPED or STOPPING
        print("Cluster is in stopped/stopping state. Starting the cluster")
        request1 = dataproc_v1.StartClusterRequest(
            project_id='qwiklabs-gcp-03-6e8213d90fd1',
            region='us-central1',
            cluster_name='my-ac-cluster',
        )
        operation = client.start_cluster(request=request1)
        print("Waiting for operation to complete...")
        response = operation.result()
        if response.status.state in (2, 5): # RUNNING or UPDATING
            print("Cluster is started successfully")
    elif response.status.state in (2, 5): # RUNNING or UPDATING
       print("Cluster is already running")
    else:
        print("Cluster is unavailable")
        raise Exception("Cluster is unavailable")

def stop_the_cluster():
    # This function is currently configured to never run as stop_cluster_check is 'False'.
    # If you intend to stop the cluster, change `stop_cluster_check` to 'True'.
    if stop_cluster_check == 'True':
        try:
            options = ClientOptions(api_endpoint="us-central1-dataproc.googleapis.com:443",
                client_cert_source=get_client_cert)
        except NameError:
            options = ClientOptions(api_endpoint="us-central1-dataproc.googleapis.com:443")

        client = dataproc_v1.ClusterControllerClient(client_options=options)
        request = dataproc_v1.StopClusterRequest(
            project_id='qwiklabs-gcp-03-6e8213d90fd1',
            region='us-central1',
            cluster_name='my-ac-cluster',
        )
        operation = client.stop_cluster(request=request)
        print("Waiting for operation to complete...")
        response = operation.result()
        if response.status.state in (6, 7): # STOPPED or STOPPING
            print("Cluster is stopped successfully")
        print(response)

with DAG(
    'dataproc_notebook_workflow', # Changed DAG ID to reflect multi-notebook functionality
    default_args=default_args,
    description='Runs multiple Jupyter notebooks on a Dataproc cluster',
    tags =['scheduler_jupyter_plugin', 'multi_notebook'],
    schedule_interval='50 16 * * 1-5', # Schedule to run at 4:50 PM, Monday-Friday
    catchup= False
) as dag:

    start_cluster = PythonOperator(
        task_id='start_cluster',
        python_callable=get_cluster_state_start_if_not_running,
        retries= 2,
        provide_context=True,
    )

    # Task for notebooka.ipynb
    input_notebook_a = 'gs://us-central1-testcomposer-9d6c1b93-bucket/dataproc-notebooks/7run/input_notebooks/notebooka.ipynb'
    output_notebook_a = "{{ ti.xcom_pull(task_ids='generate_output_file_notebooka', key='output_file_path_notebooka') }}"
    notebook_args_a = [input_notebook_a, output_notebook_a]
    parameters_a = '''
    {"param1": "value1", "param2": "value2"}
    '''
    if parameters_a.strip():
        notebook_args_a.extend(["--parameters", parameters_a])

    write_output_task_a = PythonOperator(
        task_id='generate_output_file_notebooka',
        python_callable=write_output_to_file,
        provide_context=True,
        op_kwargs={'run_id': '{{ ds_nodash }}', 'notebook_name': 'notebooka.ipynb'}, # ds_nodash provides a date string
    )

    submit_pyspark_job_a = DataprocSubmitJobOperator(
        task_id='submit_notebooka_job',
        project_id='qwiklabs-gcp-03-6e8213d90fd1',
        region='us-central1',
        job={
            'reference': {'project_id': 'qwiklabs-gcp-03-6e8213d90fd1'},
            'placement': {'cluster_name': 'my-ac-cluster'},
            'labels': {'client': 'scheduler-jupyter-plugin'},
            'pyspark_job': {
                'main_python_file_uri': 'gs://us-central1-testcomposer-9d6c1b93-bucket/dataproc-notebooks/wrapper_papermill.py',
                'args' : notebook_args_a
            },
        },
        gcp_conn_id='google_cloud_default',
    )

    # Task for notebookb.ipynb
    input_notebook_b = 'gs://us-central1-testcomposer-9d6c1b93-bucket/dataproc-notebooks/7run/input_notebooks/notebookb.ipynb'
    output_notebook_b = "{{ ti.xcom_pull(task_ids='generate_output_file_notebookb', key='output_file_path_notebookb') }}"
    notebook_args_b = [input_notebook_b, output_notebook_b]
    parameters_b = '''
    {"param_b1": "val_b1"}
    '''
    if parameters_b.strip():
        notebook_args_b.extend(["--parameters", parameters_b])

    write_output_task_b = PythonOperator(
        task_id='generate_output_file_notebookb',
        python_callable=write_output_to_file,
        provide_context=True,
        op_kwargs={'run_id': '{{ ds_nodash }}', 'notebook_name': 'notebookb.ipynb'},
    )

    submit_pyspark_job_b = DataprocSubmitJobOperator(
        task_id='submit_notebookb_job',
        project_id='qwiklabs-gcp-03-6e8213d90fd1',
        region='us-central1',
        job={
            'reference': {'project_id': 'qwiklabs-gcp-03-6e8213d90fd1'},
            'placement': {'cluster_name': 'my-ac-cluster'},
            'labels': {'client': 'scheduler-jupyter-plugin'},
            'pyspark_job': {
                'main_python_file_uri': 'gs://us-central1-testcomposer-9d6c1b93-bucket/dataproc-notebooks/wrapper_papermill.py',
                'args' : notebook_args_b
            },
        },
        gcp_conn_id='google_cloud_default',
    )

    stop_cluster = PythonOperator(
        task_id='stop_cluster',
        python_callable=stop_the_cluster,
        provide_context=True,
    )

    # Define the task dependencies
    start_cluster >> write_output_task_a >> submit_pyspark_job_a >> write_output_task_b >> submit_pyspark_job_b >> stop_cluster
