# --- Spark Session Setup ---
spark = SparkSession.builder \
    .appName("ComplexPySparkJobExtended") \
    .config("spark.sql.shuffle.partitions", 500) \
    .config("spark.executor.memory", "4g") \
    .config("spark.driver.memory", "2g") \
    .getOrCreate()

print("Spark Session created successfully.")

num_rows = 50  # Significantly increased for longer runtime (1 billion)
num_partitions = 50     # Increased partitions

print(f"Generating a DataFrame with {num_rows} rows across {num_partitions} partitions...")
large_df = spark.range(num_rows).withColumn("value", rand() * 1000) \
                                .withColumn("category", (rand() * 10).cast("integer")) \
                                .withColumn("subcategory", (rand() * 50).cast("integer")) \
                                .repartition(num_partitions)
print("Data generation complete.")

transformed_df_1 = large_df.filter(col("value") > 100) \
                           .withColumn("is_high_value", when(col("value") > 900, True).otherwise(False)) \
                           .withColumn("processed_value", col("value") * 1.05 + 50)

# First aggregation
grouped_df = transformed_df_1.groupBy("category", "subcategory") \
                             .agg(count("*").alias("record_count"),
                                  sum("value").alias("total_value"),
                                  avg("processed_value").alias("avg_processed_value"),
                                  stddev("value").alias("stddev_value"),
                                  sum(when(col("is_high_value"), 1).otherwise(0)).alias("high_value_count"))

# Introduce a window function for more complexity
window_spec_category = Window.partitionBy("category").orderBy(col("total_value").desc())
ranked_grouped_df = grouped_df.withColumn("rank_in_category", row_number().over(window_spec_category)) \
                              .withColumn("avg_value_over_category", avg("total_value").over(Window.partitionBy("category")))

lookup_data = [(i, f"Category_{i}") for i in range(10)]
lookup_df = spark.createDataFrame(lookup_data, ["category", "category_name"])

# Join with lookup_df
joined_df = ranked_grouped_df.join(lookup_df, on="category", how="left") \
                      .repartition(num_partitions // 4)

# Add another aggregation or complex operation
final_aggregated_df = joined_df.groupBy("category_name") \
                               .agg(count("*").alias("final_record_count"),
                                    sum("total_value").alias("overall_total_value"),
                                    avg("avg_processed_value").alias("overall_avg_processed_value"),
                                    sum(when(col("rank_in_category") <= 3, 1).otherwise(0)).alias("top_3_subcategories_count"))

sorted_df = final_aggregated_df.sort(col("overall_total_value").desc())

print("Triggering action (collecting a small sample) and measuring execution time...")
start_time = time.time()
sorted_df.show(10, truncate=False)
end_time = time.time()
execution_time = end_time - start_time
print(f"\nComplex PySpark job completed in {execution_time:.2f} seconds.")

# --- Write DataFrame to Parquet file in GCS ---
print(f"Writing sorted_df to Parquet file at: {GCS_OUTPUT_PATH}")
sorted_df.write.mode("overwrite").parquet(GCS_OUTPUT_PATH) # Added this line to write to Parquet
print("DataFrame successfully written to Parquet.")

# --- Stop Spark Session ---
spark.stop()
print("Spark Session stopped.")

