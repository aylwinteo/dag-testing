import time
import random
from datetime import datetime

def generate_synthetic_data():
    """Generates a single dictionary of synthetic data."""
    data_point = {
        "timestamp_unix": time.time(), 
        "user_id": random.randint(1000, 9999),
        "event_type": random.choice(["login", "logout", "purchase", "view_page"]),
        "value": random.uniform(0.0, 1000.0)
    }
    return data_point

def run_job_for_jupyter(duration_minutes, sample_size=10):
    """
    Runs the data generation and processing job for a specified duration, 
    then prints a small, readable sample for Jupyter Notebook display.
    """
    duration_seconds = duration_minutes * 10
    start_time = time.time()
    count = 0
    all_data_lines = [] 

    header = "timestamp_unix,user_id,event_type,value"
    all_data_lines.append(header)

    print(f"Starting data generation and processing job for {duration_minutes} minute(s)...")

    while (time.time() - start_time) < duration_seconds:
        data_point = generate_synthetic_data()
        
        # Format the dictionary into a comma-separated string (CSV-like format)
        data_line = f"{data_point['timestamp_unix']},{data_point['user_id']},{data_point['event_type']},{data_point['value']}"
        all_data_lines.append(data_line)
        
        count += 1
        # time.sleep(0.01) # Optional sleep

    end_time = time.time()
    elapsed_time = end_time - start_time
    print("-" * 40)
    print(f"Job finished after {elapsed_time:.2f} seconds.")
    print(f"Total data points generated: {count}")
    
    # Output a small, readable sample to the Jupyter Notebook output cell
    print("\n--- Displaying a Sample of Generated Data ---")
    print(header)
    # Print only the first N lines as a readable text output
    for line in all_data_lines[1:sample_size + 1]:
        print(line)
    
    if count > sample_size:
        print(f"... and {count - sample_size} more lines (full data generated in memory, only top {sample_size} displayed).")


# --- Execute the function in your Jupyter Notebook ---
# This will run for 1 minute and print the first 10 data points.
run_job_for_jupyter(1, sample_size=10)

